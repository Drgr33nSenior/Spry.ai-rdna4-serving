+def runtime(expected_device):
+    """Use the startup binding while retaining the per-launch device check."""
+    if type(expected_device) is not int or expected_device not in (0, 1):
+        raise ValueError('declared card 0 or 1 required')
+    if expected_device not in _BOUND_RUNTIMES:
+        raise ValueError('isolated runtime must be bound before serving')
