+    def finalize_gfx1201_mxfp4_in_proj(self) -> bool:
+        """Pack the loaded MXFP4 QKVZ and BA shards into one weight/scale pair.
+
+        The original parameters become views of the packed rows, so no weight
+        is duplicated and the separate projections still work for other row
+        counts. Each output column keeps its own K loop over the same per-row
+        quantized activations, so packed outputs equal the separate ones.
+        """
+        if not _gfx1201_packed_gdn_in_proj or self._gfx1201_in_proj is not None:
+            return self._gfx1201_in_proj is not None
+        if get_lora().enable_lora or get_lora().lora_paths:
+            return False
+        from sglang.srt.layers.quantization.quark.schemes import quark_w4a4_mxfp4
+
+        qkvz, ba = self.in_proj_qkvz, self.in_proj_ba
+        if not (
+            quark_w4a4_mxfp4._use_gfx1201_mxfp4
+            and all(
+                type(getattr(proj, "scheme", None)) is quark_w4a4_mxfp4.QuarkW4A4MXFP4
+                and proj.bias is None
+                and not getattr(proj, "use_aiter_asm_fp4_gemm", False)
+                and not getattr(proj, "dequantized_bf16", False)
+                and proj.weight.dtype == torch.uint8
+                and getattr(proj, "weight_scale", None) is not None
+                and proj.weight_scale.dtype == torch.uint8
+                and proj.weight.is_contiguous()
+                and proj.weight_scale.is_contiguous()
+                for proj in (qkvz, ba)
+            )
+            and qkvz.weight.shape[1] == ba.weight.shape[1]
+            and qkvz.weight_scale.shape[1] == ba.weight_scale.shape[1]
+        ):
+            return False
+        rows = qkvz.weight.shape[0]
+        weight = torch.cat([qkvz.weight.data, ba.weight.data], dim=0).contiguous()
+        scale = torch.cat([qkvz.weight_scale.data, ba.weight_scale.data], dim=0).contiguous()
+        qkvz.weight.data, ba.weight.data = weight[:rows], weight[rows:]
+        qkvz.weight_scale.data, ba.weight_scale.data = scale[:rows], scale[rows:]
+        self._gfx1201_in_proj = (weight, scale, rows)
+        return True
+
