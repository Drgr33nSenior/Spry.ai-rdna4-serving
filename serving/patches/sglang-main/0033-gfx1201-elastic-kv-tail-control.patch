+    def test_base_only_descendants_of_a_tail_holder_go_with_it(self):
+        rank = _Rank(self)
+        rank.grow()
+        held = rank.allocator.alloc(BASE)  # fill the base: the parent gets the tail
+        parent = list(range(1, 21))
+        self._insert(rank.cache, rank.allocator, rank.pool, parent)
+        rank.allocator.free(held)
+        # Inserted with the base free again: the child and the other prefix
+        # hold base slots only.
+        child = parent + list(range(1001, 1021))
+        other = list(range(2001, 2021))
+        for seq in (child, other):
+            self._insert(rank.cache, rank.allocator, rank.pool, seq)
+        _, child_slots = self._path_slots(rank, child)
+        self.assertEqual(int((child_slots > BASE).sum()), len(parent))
+        evicted, left = ekt.evict_tail_holders(rank.cache, BASE)
+        self.assertEqual((evicted, left), (len(child), 0))
+        self.assertEqual(match_prefix(rank.cache, child).device_prefix_len, 0)
+        self.assertEqual(match_prefix(rank.cache, other).device_prefix_len, len(other))
+        self.assertEqual(rank.full.tail_outstanding, 0)
+        rank.cache.sanity_check()
+        # Locked below the tail holder: nothing of the path can go yet.
+        held = rank.allocator.alloc(BASE - len(other))
+        self._insert(rank.cache, rank.allocator, rank.pool, parent)
+        rank.allocator.free(held)
+        node = self._insert(rank.cache, rank.allocator, rank.pool, child)
+        lock = rank.cache.lock(node.last_device_node)
+        evicted, left = ekt.evict_tail_holders(rank.cache, BASE)
+        self.assertEqual(evicted, 0)
+        self.assertGreater(left, 0)
+        self.assertEqual(match_prefix(rank.cache, child).device_prefix_len, len(child))
+        rank.cache.unlock(lock)
+        self.assertEqual(ekt.evict_tail_holders(rank.cache, BASE), (len(child), 0))
+        rank.cache.sanity_check()
