@@ -0,0 +1,1406 @@
+"""Elastic KV tail (SGLANG_GFX1201_ELASTIC_KV_BASE_TOKENS) on the CPU.
+
+Device memory is a FakeVmmBackend, so nothing here needs a GPU. The prefix
+cache is the unified radix cache as the gfx1201 serving arms run it: Full, SWA
+and Mamba slots with SWA checkpoint windows, page size 1, Python tree core.
+
+Run with tools/run_sglang_unit_on_cpu.py (the cache kit is gated on CUDA).
+"""
+
+import asyncio
+import ctypes
+import os
+import random
+import threading
+import unittest
+from types import SimpleNamespace
+from unittest import mock
+
+import torch
+
+from sglang.srt.managers.io_struct import (
+    KvTailReqInput,
+    KvTailReqOutput,
+    KvTailStatusReqInput,
+    KvTailStatusReqOutput,
+)
+from sglang.srt.mem_cache import elastic_kv_tail as ekt
+from sglang.srt.mem_cache.allocator.token import TokenToKVPoolAllocator
+from sglang.srt.mem_cache.memory_pool import KvBufferDesc, MHATokenToKVPool
+from sglang.srt.mem_cache.unified_cache.components.base import ComponentType
+from sglang.test.ci.ci_register import register_cpu_ci
+from sglang.test.kits.unified_radix_cache.checkpoint_window import (
+    SWACheckpointWindowFixtures,
+)
+from sglang.test.kits.unified_radix_cache.config import CacheConfig
+from sglang.test.kits.unified_radix_cache.fixtures import match_prefix
+from sglang.test.test_utils import CustomTestCase
+
+register_cpu_ci(est_time=60, suite="base-a-test-cpu")
+
+BASE = 192
+POOL = 512
+ROW = 16  # bytes per token and buffer in the fake pool
+GRAN = 4096
+
+
+def _token_allocator(size):
+    return TokenToKVPoolAllocator(size, torch.bfloat16, "cpu", None, False)
+
+
+def _descs(pool_tokens=POOL, layers=2):
+    shape = (pool_tokens + 1, 2, ROW // 2)
+    return [
+        KvBufferDesc(f"{kind}{layer}", shape, row_bytes=ROW, tokens_per_row=1)
+        for kind in "kv"
+        for layer in range(layers)
+    ]
+
+
+def _owner(backend=None, base=BASE, pool_tokens=POOL):
+    return ekt.TailBufferOwner(
+        backend=backend or ekt.FakeVmmBackend(granularity=GRAN),
+        descs=_descs(pool_tokens),
+        store_dtype=torch.uint8,
+        page_size=1,
+        base_tokens=base,
+        reserved_tokens=pool_tokens,
+    )
+
+
+class _ReferenceAllocator:
+    """TokenToKVPoolAllocator as upstream has it at the pin (need_sort off)."""
+
+    def __init__(self, size):
+        self.free_pages = torch.arange(1, size + 1, dtype=torch.int64)
+
+    def available_size(self):
+        return len(self.free_pages)
+
+    def alloc(self, need_size):
+        if need_size > len(self.free_pages):
+            return None
+        select = self.free_pages[:need_size]
+        self.free_pages = self.free_pages[need_size:]
+        return select
+
+    def free(self, free_index):
+        if free_index.numel():
+            self.free_pages = torch.cat((self.free_pages, free_index))
+
+
+class TestTailAllocator(CustomTestCase):
+    def test_without_the_tail_the_allocator_is_unchanged(self):
+        for seed in range(5):
+            rng = random.Random(seed)
+            new, ref = _token_allocator(300), _ReferenceAllocator(300)
+            held = []
+            for _ in range(400):
+                if held and rng.random() < 0.45:
+                    index = held.pop(rng.randrange(len(held)))
+                    new.free(index)
+                    ref.free(index.clone())
+                else:
+                    need = rng.randint(1, 60)
+                    got, want = new.alloc(need), ref.alloc(need)
+                    self.assertEqual(got is None, want is None)
+                    if got is not None:
+                        self.assertTrue(torch.equal(got, want))
+                        held.append(got)
+                self.assertEqual(new.available_size(), ref.available_size())
+                self.assertTrue(torch.equal(new.free_pages, ref.free_pages))
+            self.assertEqual(new.tail_outstanding, 0)
+            self.assertEqual(new.unavailable_size(), 0)
+            self.assertIsNone(new._tail_free)
+
+    def test_low_slots_first(self):
+        alloc = _token_allocator(48)
+        alloc.enable_elastic_tail(16)
+        alloc.open_tail(32)
+        first = alloc.alloc(10)
+        self.assertEqual(first.tolist(), list(range(1, 11)))
+        alloc.free(torch.tensor([3, 4]))
+        # Six low slots never used, then the two freed ones: no tail slot yet.
+        second = alloc.alloc(8)
+        self.assertEqual(second.tolist(), [11, 12, 13, 14, 15, 16, 3, 4])
+        self.assertEqual(alloc.tail_outstanding, 0)
+        alloc.free(torch.tensor([7]))
+        third = alloc.alloc(4)
+        self.assertEqual(third.tolist(), [7, 17, 18, 19])
+        self.assertEqual(alloc.tail_outstanding, 3)
+
+    def test_random_operations_take_the_tail_last_and_conserve_slots(self):
+        for seed in range(6):
+            rng = random.Random(seed)
+            size, base = 200, 80
+            alloc = _token_allocator(size)
+            alloc.enable_elastic_tail(base)
+            held, in_use, is_open, tail = [], 0, False, 0
+            for _ in range(600):
+                op = rng.random()
+                if op < 0.05 and not is_open and alloc.tail_outstanding == 0:
+                    if tail:
+                        alloc.drop_tail()
+                    tail = rng.randint(1, size - base)
+                    alloc.open_tail(tail)
+                    is_open = True
+                elif op < 0.10 and is_open:
+                    alloc.close_tail()
+                    is_open = False
+                elif op < 0.13 and tail and not is_open:
+                    alloc.reopen_tail()
+                    is_open = True
+                elif op < 0.5 and held:
+                    index = held.pop(rng.randrange(len(held)))
+                    in_use -= index.numel()
+                    alloc.free(index)
+                else:
+                    need = rng.randint(1, 40)
+                    low_free = len(alloc.free_pages)
+                    got = alloc.alloc(need)
+                    if got is None:
+                        self.assertGreater(need, alloc.available_size())
+                    else:
+                        num_tail = int((got > base).sum())
+                        self.assertEqual(num_tail, max(0, need - low_free))
+                        if num_tail:
+                            self.assertTrue(is_open)
+                            self.assertLessEqual(int(got.max()), base + tail)
+                        held.append(got)
+                        in_use += need
+                tail_in_use = sum(int((h > base).sum()) for h in held)
+                self.assertEqual(alloc.tail_outstanding, tail_in_use)
+                self.assertEqual(
+                    alloc.available_size() + in_use + alloc.unavailable_size(), size
+                )
+                everything = torch.cat([alloc.free_pages, alloc._tail_free, *held])
+                self.assertEqual(everything.numel(), everything.unique().numel())
+
+    def test_closed_tail_is_never_handed_out(self):
+        alloc = _token_allocator(48)
+        alloc.enable_elastic_tail(16)
+        self.assertEqual(alloc.available_size(), 16)
+        self.assertEqual(alloc.unavailable_size(), 32)
+        self.assertIsNone(alloc.alloc(17))
+        self.assertEqual(alloc.alloc(16).tolist(), list(range(1, 17)))
+        self.assertIsNone(alloc.alloc(1))
+        alloc.open_tail(20)
+        self.assertEqual(alloc.available_size(), 20)
+        self.assertEqual(alloc.unavailable_size(), 12)
+        held = alloc.alloc(5)
+        self.assertEqual(held.tolist(), [17, 18, 19, 20, 21])
+        alloc.close_tail()
+        self.assertEqual(alloc.available_size(), 0)
+        self.assertIsNone(alloc.alloc(1))
+        # A freed tail slot goes back to the tail, not into circulation.
+        alloc.free(held[:2])
+        self.assertEqual(alloc.available_size(), 0)
+        self.assertEqual(alloc.tail_outstanding, 3)
+        self.assertEqual(alloc.unavailable_size(), 32 - 3)
+        alloc.free(torch.tensor([5, 6]))
+        self.assertEqual(alloc.alloc(2).tolist(), [5, 6])
+        alloc.free(held[2:])
+        self.assertEqual(alloc.tail_outstanding, 0)
+        alloc.drop_tail()
+        self.assertEqual(alloc.unavailable_size(), 32)
+
+    def test_clear_keeps_the_gate(self):
+        alloc = _token_allocator(48)
+        alloc.enable_elastic_tail(16)
+        alloc.open_tail(8)
+        alloc.alloc(20)
+        alloc.clear()
+        self.assertEqual(alloc.available_size(), 24)
+        self.assertEqual(alloc.tail_outstanding, 0)
+        alloc.alloc(20)
+        alloc.close_tail()
+        alloc.clear()
+        self.assertEqual(alloc.available_size(), 16)
+        self.assertEqual(alloc.tail_outstanding, 0)
+
+    def test_enable_rejects_a_used_or_sorted_pool(self):
+        alloc = _token_allocator(48)
+        alloc.alloc(1)
+        with self.assertRaises(RuntimeError):
+            alloc.enable_elastic_tail(16)
+        with self.assertRaises(ValueError):
+            TokenToKVPoolAllocator(
+                48, torch.bfloat16, "cpu", None, True
+            ).enable_elastic_tail(16)
+
+
+class TestTailBuffers(CustomTestCase):
+    def test_only_the_base_is_backed_and_zero(self):
+        backend = ekt.FakeVmmBackend(granularity=GRAN)
+        owner = _owner(backend)
+        base_bytes = ekt.align_up((BASE + 1) * ROW, GRAN)
+        self.assertEqual(len(owner.tensors), 4)
+        for tensor, buf in zip(owner.tensors, owner._buffers):
+            self.assertEqual(tuple(tensor.shape), (POOL + 1, 2, ROW // 2))
+            self.assertTrue(tensor.is_contiguous())
+            self.assertEqual(tensor.data_ptr(), buf.address)
+            self.assertEqual(buf.address % 16, 0)
+            self.assertEqual(buf.base_bytes, base_bytes)
+            self.assertTrue(backend.is_mapped(buf.address, base_bytes))
+            self.assertFalse(backend.is_mapped(buf.address + base_bytes, GRAN))
+            self.assertEqual(int(tensor[: BASE + 1].max()), 0)
+        self.assertEqual(backend.mapped_bytes(), 4 * base_bytes)
+        owner.close()
+        self.assertEqual(backend.mapped_bytes(), 0)
+
+    def test_one_tail_extent_per_buffer_zeroed_and_released(self):
+        backend = ekt.FakeVmmBackend(granularity=GRAN)
+        owner = _owner(backend)
+        del backend.log[:]
+        mapped = owner.map_tail(owner.reserved_tail_tokens)
+        maps = [entry for entry in backend.log if entry[0] == "map"]
+        self.assertEqual(len(maps), len(owner.tensors))
+        self.assertEqual(mapped, sum(size for _, _, size in maps))
+        self.assertEqual(mapped, owner.tail_bytes_for(owner.reserved_tail_tokens))
+        for (_, address, size), buf, tensor in zip(maps, owner._buffers, owner.tensors):
+            self.assertEqual(address, buf.address + buf.base_bytes)
+            self.assertEqual(address + size, buf.address + buf.reserved_bytes)
+            # The fake fills a fresh map with 0xA5; the tail must read zero.
+            self.assertEqual(int(tensor.max()), 0)
+        released = owner.unmap_tail()
+        self.assertEqual(released, mapped)
+        self.assertEqual(backend.mapped_bytes(), owner.base_bytes)
+        with self.assertRaises(ValueError):
+            owner.map_tail(owner.reserved_tail_tokens + 1)
+
+    def test_a_partial_tail_backs_only_its_rows(self):
+        backend = ekt.FakeVmmBackend(granularity=GRAN)
+        owner = _owner(backend)
+        mapped = owner.map_tail(100)
+        want = ekt.align_up((BASE + 100 + 1) * ROW, GRAN) - ekt.align_up(
+            (BASE + 1) * ROW, GRAN
+        )
+        self.assertEqual(mapped, 4 * want)
+        for buf in owner._buffers:
+            last_row = buf.address + (BASE + 100) * ROW
+            self.assertTrue(backend.is_mapped(last_row, ROW))
+
+    def test_base_survives_grow_and_shrink_cycles_at_the_same_address(self):
+        backend = ekt.FakeVmmBackend(granularity=GRAN)
+        owner = _owner(backend)
+        generator = torch.Generator().manual_seed(0)
+        for tensor in owner.tensors:
+            tensor[: BASE + 1] = torch.randint(
+                0, 255, tensor[: BASE + 1].shape, generator=generator, dtype=torch.uint8
+            )
+        checksum = owner.base_checksum()
+        addresses = [tensor.data_ptr() for tensor in owner.tensors]
+        for cycle in range(50):
+            owner.map_tail(owner.reserved_tail_tokens if cycle % 2 else 150)
+            for tensor in owner.tensors:
