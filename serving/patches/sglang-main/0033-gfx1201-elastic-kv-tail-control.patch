+class _Clock:
+    def __init__(self):
+        self.now = 1000.0
+
+    def __call__(self):
+        return self.now
+
+
+class _Rank:
+    """One simulated TP rank: cache, allocator, buffers, request table and
+    its tail. K and V of every token it places carry a value derived from the
+    token, so a moved or lost row shows."""
+
+    def __init__(self, suite, rank=0, gather=None, backend=None):
+        self.suite = suite
+        self.cache, self.allocator, self.pool = suite._build()
+        self.full = self.allocator.full_attn_allocator
+        self.table = self.pool.req_to_token
+        self.mapping = self.allocator.full_to_swa_index_mapping
+        self.backend = backend or ekt.FakeVmmBackend(granularity=GRAN)
+        self.owner = _owner(self.backend, pool_tokens=suite.cfg.kv_size)
+        self.full.enable_elastic_tail(BASE)
+        self.clock = _Clock()
+        self.limits = []
+        self.outputs = []
+        self.events = []
+        # Rows from the top of the table; the cache kit takes them from 0.
+        self.free_rows = list(range(self.table.shape[0] - 100, self.table.shape[0]))
+        self.live = {}
+        self._watch(self.full, "close_tail", "close")
+        self._watch(self.owner, "copy_rows", "copy")
+        self._watch(self.owner, "unmap_tail", "unmap")
+        self.tail = ekt.ElasticKvTail(
+            owner=self.owner,
+            allocator=self.full,
+            swa_allocator=self.allocator,
+            tree_cache=self.cache,
+            req_to_token=self.table,
+            live_rows=lambda: [
+                (row, len(req["tokens"])) for row, req in self.live.items()
+            ],
+            context_length=90,
+            input_len_margin=5,
+            apply_limits=lambda *limits: self.limits.append(limits),
+            gather=gather or (lambda report: [report]),
+            send_output=lambda output, req: (
+                self.events.append("ack"),
+                self.outputs.append(output),
+            ),
+            make_output=KvTailReqOutput,
+            rank=rank,
+            clock=self.clock,
+        )
+
+    def _watch(self, obj, name, event):
+        original = getattr(obj, name)
+
+        def wrapper(*args, **kwargs):
+            self.events.append(event)
+            return original(*args, **kwargs)
+
+        setattr(obj, name, wrapper)
+
+    def grow(self, tokens=None, **kwargs):
+        return self.tail.handle(
+            KvTailReqInput(action="grow", tail_tokens=tokens, keep_free_mib=0, **kwargs)
+        )
+
+    def shrink(self, **kwargs):
+        return self.tail.handle(KvTailReqInput(action="shrink", **kwargs))
+
+    def tree_slots(self):
+        return self.cache.all_values_flatten()
+
+    # -- KV content ---------------------------------------------------------
+
+    @staticmethod
+    def _pattern(tokens, layer):
+        tokens = torch.as_tensor(list(tokens), dtype=torch.int64)
+        return ((tokens * 7 + layer) % 251 + 1).to(torch.uint8)
+
+    def write(self, slots, tokens):
+        for layer, tensor in enumerate(self.owner.tensors):
+            tensor[slots.to(torch.int64)] = self._pattern(tokens, layer)[:, None, None]
+
+    def holds(self, slots, tokens):
+        slots = slots.to(torch.int64)
+        return all(
+            torch.equal(
+                tensor[slots],
+                self._pattern(tokens, layer)[:, None, None].expand(
+                    -1, *tensor.shape[1:]
+                ),
+            )
+            for layer, tensor in enumerate(self.owner.tensors)
+        )
+
+    # -- prefixes and requests ----------------------------------------------
+
+    def insert(self, seq):
+        """Cache ``seq`` as a finished request would; False without room."""
+        if not self.suite._make_room(self.cache, self.allocator, len(seq)):
+            return False
+        node = self.suite._insert(self.cache, self.allocator, self.pool, seq)
+        self.write(self.cache.path_device_indices(node.last_device_node), seq)
+        return True
+
+    def cached_slots(self, seq):
+        """The slots of ``seq`` if the cache holds all of it, else None."""
+        match = match_prefix(self.cache, seq)
+        if match.device_prefix_len != len(seq):
+            return None
+        return self.cache.path_device_indices(match.last_device_node)
+
+    def start(self, tokens, prefix=None):
+        """A running request: a table row, an optional locked cached prefix
+        and ``tokens`` of its own. Returns the row, or None without room."""
+        lock, shared = None, torch.empty(0, dtype=torch.int64)
+        if prefix is not None:
+            match = match_prefix(self.cache, prefix)
+            assert match.device_prefix_len == len(prefix)
+            lock = self.cache.lock(match.last_device_node)
+            shared = self.cache.path_device_indices(match.last_device_node)
+        if not self.suite._make_room(self.cache, self.allocator, len(tokens)):
+            self.cache.unlock(lock)
+            return None
+        own = self.allocator.alloc(len(tokens))
+        self.write(own, tokens)
+        row = self.free_rows.pop()
+        slots = torch.cat((shared.to(torch.int64), own))
+        self.table[row, : slots.numel()] = slots.to(self.table.dtype)
+        self.live[row] = dict(
+            tokens=list(prefix or []) + list(tokens),
+            prefix=list(prefix or []),
+            lock=lock,
+        )
+        return row
+
+    def row_slots(self, row):
+        return self.table[row, : len(self.live[row]["tokens"])].to(torch.int64)
+
+    def finish(self, row):
+        """The request ends: its own slots are freed, its lock released. Its
+        slot ids stay in the table row, as they do in the server."""
+        own = self.row_slots(row)[len(self.live[row]["prefix"]) :].clone()
+        req = self.live.pop(row)
+        self.allocator.free(own)
+        self.cache.unlock(req["lock"])
+        self.free_rows.insert(0, row)
+
+    def check_content(self, seqs=()):
+        """Every running request and every fully cached prefix still has its
+        own K and V, and a request's shared prefix is the cache's slots."""
+        test = self.suite
+        for row, req in self.live.items():
+            slots = self.row_slots(row)
+            test.assertTrue(self.holds(slots, req["tokens"]), f"row {row}")
+            if req["prefix"]:
+                cached = self.cached_slots(req["prefix"])
+                test.assertIsNotNone(cached, "a locked prefix left the cache")
+                test.assertTrue(torch.equal(slots[: len(cached)], cached))
+        for seq in seqs:
+            cached = self.cached_slots(seq)
+            if cached is not None:
+                test.assertTrue(self.holds(cached, seq), f"prefix {seq[:3]}")
+
+    def assert_no_tail_refs(self):
+        test = self.suite
+        test.assertEqual(int((self.tree_slots() > BASE).sum()), 0)
+        test.assertLessEqual(int(self.table.max()), BASE)
+        test.assertEqual(self.full.tail_outstanding, 0)
+        test.assertEqual(self.backend.mapped_bytes(), self.owner.base_bytes)
+
+
+class ElasticTailSuite(SWACheckpointWindowFixtures):
+    def _seqs(self, rng, count, start=1):
+        """``count`` token sequences, some extending an earlier one."""
+        seqs, next_token = [], start
+        for _ in range(count):
+            base = rng.choice(seqs) if seqs and rng.random() < 0.5 else []
+            keep = rng.randrange(len(base) + 1)
+            extra = rng.randint(4, 3 * self.window)
+            seqs.append(base[:keep] + list(range(next_token, next_token + extra)))
+            next_token += extra
+        return seqs
+
+    def _assert_windows(self, rank, seqs):
+        for seq in seqs:
+            match = match_prefix(rank.cache, seq)
+            node = match.last_device_node
+            if node == rank.cache.root_node_handle():
+                continue
+            spans = self._path(rank.cache, node, match.device_prefix_len)
+            for _, end, _, has_checkpoint in spans:
+                if not has_checkpoint:
+                    continue
+                window_start = max(0, end - self.window)
+                for start, stop, has_swa, _ in spans:
+                    if stop > window_start and start < end:
+                        self.assertTrue(has_swa)
+
+    def _assert_conserved(self, rank):
+        # The leak check's identity: free + cached + unavailable = pool, with
+        # what running requests hold outside the cache.
+        own = sum(len(r["tokens"]) - len(r["prefix"]) for r in rank.live.values())
+        self.assertEqual(
+            rank.full.available_size()
+            + rank.cache.full_evictable_size()
+            + rank.cache.full_protected_size()
+            + rank.full.unavailable_size()
+            + own,
+            self.cfg.kv_size,
+        )
+
+    # -- tests --------------------------------------------------------------
+
+    def test_starts_unbacked_at_the_base(self):
+        rank = _Rank(self)
+        self.assertEqual(rank.tail.state, ekt.STATE_UNBACKED)
+        self.assertEqual(rank.limits[-1], (BASE, 89, 84))
+        self.assertEqual(rank.full.available_size(), BASE)
+        status = ekt.dispatch(rank.tail, KvTailStatusReqInput(), KvTailStatusReqOutput)
+        self.assertIsInstance(status, KvTailStatusReqOutput)
+        self.assertEqual(status.info["reserved_tail_tokens"], self.cfg.kv_size - BASE)
+        self.assertEqual(status.info["context_length"], 90)
+        off = ekt.dispatch(None, KvTailReqInput(action="grow"), KvTailReqOutput)
+        self.assertFalse(off.ok)
+        self.assertEqual(off.state, ekt.STATE_DISABLED)
+        self.assertTrue(
+            ekt.dispatch(None, KvTailStatusReqInput(), KvTailStatusReqOutput).ok
+        )
+
+    def test_grow_adds_cache_room_and_leaves_the_context_alone(self):
+        rank = _Rank(self)
+        tail_tokens = self.cfg.kv_size - BASE
+        out = rank.grow()
+        self.assertTrue(out.ok, out.message)
+        self.assertEqual(out.state, ekt.STATE_BACKED)
+        self.assertEqual(out.info["tail_tokens"], tail_tokens)
+        self.assertEqual(out.info["mapped_bytes"], rank.owner.tail_bytes)
+        self.assertEqual(rank.full.available_size(), self.cfg.kv_size)
+        # The pool is larger; what one request may use is not.
+        self.assertEqual(out.info["context_length"], 90)
+        self.assertEqual(out.info["pool_tokens"], self.cfg.kv_size)
+        self.assertEqual(rank.limits[-1], (self.cfg.kv_size, 89, 84))
+        self.assertTrue(rank.grow().ok)  # idempotent
