+        self.assertTrue(torch.equal(k_buffer[moved][:, 0, 0], values))
+        self.assertEqual(table[3, :4].tolist(), [5, BASE, 0, 0])
+        self.assertEqual(int((table > BASE).sum()), 0)
+        self.assertEqual(self.backend.mapped_bytes(), tail.owner.base_bytes)
+        allocator.free(moved)
+        self.assertEqual(allocator.full_available_size(), BASE)
