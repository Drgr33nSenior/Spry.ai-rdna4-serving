+    def _http(self, tokenizer, method="POST", body=None):
+        import orjson
+
+        from sglang.srt.entrypoints import http_server
+
+        payload = b"" if body is None else orjson.dumps(body)
+
+        async def read_body():
+            return payload
+
+        async def read_json():
+            return orjson.loads(payload)
+
+        request = SimpleNamespace(method=method, body=read_body, json=read_json)
+        state = SimpleNamespace(tokenizer_manager=tokenizer)
+        with mock.patch.object(http_server, "_global_state", state):
+            response = asyncio.run(http_server.kv_tail(request))
+        return response.status_code, orjson.loads(response.body)
