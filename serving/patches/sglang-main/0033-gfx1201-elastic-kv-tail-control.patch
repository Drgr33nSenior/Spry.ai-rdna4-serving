+        self.assertEqual(int(rank.mapping[old_a].sum()), 0)
+        self.assertEqual(int(rank.mapping[old_b].sum()), 0)
+        self.assertGreaterEqual(rank.allocator.swa_available_size(), swa_free)
+        rank.cache.sanity_check()
+        self._assert_windows(rank, idle + [shared])
