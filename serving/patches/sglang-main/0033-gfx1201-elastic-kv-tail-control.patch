+            filler = rank.allocator.alloc(rank.full.available_size() - 300)
+            self.assertTrue(rank.insert(shared))
+            rows.append(
+                (
+                    rank.start(range(7000, 7025), prefix=shared),
+                    rank.start(range(8000, 8040)),
+                )
+            )
+            rank.allocator.free(filler)
+        self.assertEqual(rows[0], rows[1])
+        return idle + [shared]
