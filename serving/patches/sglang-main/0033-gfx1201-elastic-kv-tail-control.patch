+    def test_random_traffic_with_grow_and_shrink_cycles(self):
+        for seed in range(6):
+            with self.subTest(seed=seed):
+                self._run_random_cycles(seed)
+
+    def _run_random_cycles(self, seed):
+        rank = _Rank(self)
+        rng = random.Random(seed)
+        seqs, locks, next_token = [], [], 1
+        shrinks = migrated = refused = 0
+        for _ in range(500):
+            op = rng.random()
+            state = rank.tail.state
+            if op < 0.05 and state == ekt.STATE_UNBACKED:
+                tokens = rng.randint(1, self.cfg.kv_size - BASE)
+                self.assertTrue(rank.grow(tokens).ok)
+            elif op < 0.12 and state == ekt.STATE_BACKED:
+                before = {row: rank.row_slots(row).clone() for row in rank.live}
+                out = rank.shrink()
+                self.assertIsNotNone(out)  # never deferred for a request
+                if out.ok:
+                    shrinks += 1
+                    migrated += out.info["migrated_tokens"]
+                    self.assertTrue(out.info["verified_no_tail_refs"])
+                    rank.assert_no_tail_refs()
+                else:
+                    refused += 1
+                    self.assertEqual(out.info["reason"], "cannot_migrate")
+                    self.assertEqual(rank.tail.state, ekt.STATE_BACKED)
+                    for row, slots in before.items():
+                        self.assertTrue(torch.equal(rank.row_slots(row), slots))
+            elif op < 0.40 or not seqs:
+                (seq,) = self._seqs(rng, 1, next_token)
+                if seqs and rng.random() < 0.5:
+                    base = rng.choice(seqs)
+                    seq = base[: rng.randrange(len(base) + 1)] + seq
+                next_token += len(seq)
+                if rank.insert(seq):
+                    seqs.append(seq)
+            elif op < 0.55 and len(rank.live) < 3:
+                prefix = None
+                if rng.random() < 0.6:
+                    prefix = rng.choice(seqs)
+                    if rank.cached_slots(prefix) is None:
+                        prefix = None
+                own = range(next_token, next_token + rng.randint(1, 30))
+                next_token += len(own)
+                rank.start(own, prefix=prefix)
+            elif op < 0.68 and rank.live:
+                rank.finish(rng.choice(sorted(rank.live)))
+            elif op < 0.85:
+                match = match_prefix(rank.cache, rng.choice(seqs))
+                if match.last_device_node != rank.cache.root_node_handle():
+                    locks.append(rank.cache.lock(match.last_device_node))
+            elif locks:
+                rank.cache.unlock(locks.pop(rng.randrange(len(locks))))
+            rank.cache.sanity_check()
+            rank.check_content(seqs)
+            self._assert_windows(rank, seqs)
+            self._assert_conserved(rank)
+            slots = rank.tree_slots()
+            backed = rank.tail.state != ekt.STATE_UNBACKED
+            limit = BASE + (rank.tail.tail_tokens if backed else 0)
+            if slots.numel():
+                self.assertLessEqual(int(slots.max()), limit)
+            for row in rank.live:
+                self.assertLessEqual(int(rank.row_slots(row).max()), limit)
+            (full_capacity, full_available), _ = (
+                rank.allocator.swa_capacity_and_available(
+                    full_capacity=self.cfg.kv_size, swa_capacity=0
+                )
+            )
+            self.assertEqual(
+                full_capacity - full_available,
+                self.cfg.kv_size
+                - rank.full.available_size()
+                - rank.full.unavailable_size(),
+            )
+        self.assertGreater(shrinks, 3)
+        return shrinks, migrated, refused
+
+    def test_random_traffic_does_move_requests(self):
+        totals = [self._run_random_cycles(seed) for seed in range(6, 9)]
+        self.assertGreater(sum(migrated for _, migrated, _ in totals), 0)
