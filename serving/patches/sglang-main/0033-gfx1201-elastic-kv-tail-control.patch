+    def test_shrink_order_with_idle_prefixes_and_a_running_request(self):
+        rank = _Rank(self)
+        rank.grow()
+        rng = random.Random(1)
+        seqs, _ = self._fill(rank, rng, 40)
+        held = rank.allocator.alloc(30)  # a running request's own slots
+        self.assertGreater(int(held.max()), BASE)
+        tail_seqs, base_seqs = [], []
+        for seq, _ in seqs:
+            match, slots = self._path_slots(rank, seq)
+            if match.device_prefix_len == len(seq):
+                (tail_seqs if int(slots.max()) > BASE else base_seqs).append(seq)
+        self.assertTrue(tail_seqs and base_seqs)
+        # A running request has one tail-holding prefix locked.
+        locked_seq = tail_seqs[0]
+        lock = rank.cache.lock(match_prefix(rank.cache, locked_seq).last_device_node)
+        locked_slots = self._path_slots(rank, locked_seq)[1]
+
+        self.assertIsNone(rank.shrink())
+        self.assertEqual(rank.events, ["close"])
+        self.assertEqual(rank.tail.state, ekt.STATE_DRAINING)
+        self.assertEqual(rank.limits[-1], (BASE, 89, 84))
+        # 1. No tail slot is handed out any more.
+        self.assertLessEqual(rank.full.available_size(), BASE)
+        got = rank.full.alloc(rank.full.available_size())
+        self.assertTrue(got.numel() == 0 or int(got.max()) <= BASE)
+        rank.full.free(got)
+        # 2. Idle prefixes in the tail are gone; the locked one and every
+        #    prefix that fits the base are still cached.
+        slots = rank.tree_slots()
+        in_tail = slots[slots > BASE]
+        self.assertTrue(set(in_tail.tolist()) <= set(locked_slots.tolist()))
+        self.assertEqual(
+            match_prefix(rank.cache, locked_seq).device_prefix_len, len(locked_seq)
+        )
+        for seq in base_seqs:
+            match, kept = self._path_slots(rank, seq)
+            if match.device_prefix_len:
+                self.assertLessEqual(int(kept.max()), BASE)
+        kept_base = [
+            seq
+            for seq in base_seqs
+            if match_prefix(rank.cache, seq).device_prefix_len == len(seq)
+        ]
+        self.assertTrue(kept_base)
+        rank.cache.sanity_check()
+        self._assert_windows(rank, seqs)
+        # 3. It waits: nothing is unmapped while tail slots are in use.
+        for _ in range(3):
+            rank.tail.check_pending()
+        self.assertEqual(rank.events, ["close"])
+        self.assertEqual(rank.outputs, [])
+        status = rank.tail.status()
+        self.assertEqual(status["context_length"], 90)
+        self.assertGreater(status["pending"]["waiting_for_tail_slots"], 0)
+        busy = rank.grow()
+        self.assertEqual(busy.info["reason"], "busy")
+        # The request finishes: its lock goes, then its own slots.
+        rank.cache.unlock(lock)
+        rank.tail.check_pending()
+        self.assertEqual(rank.events, ["close"])
+        rank.allocator.free(held)
+        rank.tail.check_pending()
+        # 4. Unmap, then 5. acknowledge.
+        self.assertEqual(rank.events, ["close", "scrub", "unmap", "ack"])
+        (out,) = rank.outputs
+        self.assertTrue(out.ok, out.message)
+        self.assertTrue(out.info["waited"])
+        self.assertGreater(out.info["evicted_tokens"], 0)
+        self.assertGreater(out.info["waited_for"]["tail_slots_in_use"], 0)
+        self.assertEqual(rank.backend.mapped_bytes(), rank.owner.base_bytes)
+        slots = rank.tree_slots()
+        self.assertEqual(int((slots > BASE).sum()), 0)
+        for seq in kept_base:
+            self.assertEqual(match_prefix(rank.cache, seq).device_prefix_len, len(seq))
+        rank.cache.sanity_check()
