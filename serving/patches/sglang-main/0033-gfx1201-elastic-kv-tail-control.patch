+    def test_http_endpoint(self):
+        info = {"context_length": 250, "tail_tokens": 320, "waited": False}
+        status = KvTailStatusReqOutput(ok=True, state="unbacked", info={"x": 1})
+        tokenizer = self._tokenizer(
+            [
+                status,
+                status,
+                KvTailReqOutput(ok=True, state="backed", message="m", info=info),
+                KvTailReqOutput(
+                    ok=False, state="backed", info={"reason": "timeout"}
+                ),
+            ]
+        )
+        with mock.patch.dict(os.environ):
+            os.environ.pop(ekt.ENV_BASE_TOKENS, None)
+            self.assertEqual(
+                self._http(tokenizer, "GET"),
+                (200, {"x": 1, "ok": True, "state": "unbacked", "message": ""}),
+            )
+            self.assertEqual(self._http(tokenizer, body={"action": "status"})[0], 200)
+            code, body = self._http(
+                tokenizer, body={"action": "grow", "tail_tokens": 320}
+            )
+            self.assertEqual(code, 200)
+            self.assertEqual(
+                body, {**info, "ok": True, "state": "backed", "message": "m"}
+            )
+            self.assertEqual(tokenizer.seen[-1][0], "grow")
+            code, body = self._http(
+                tokenizer, body={"action": "shrink", "timeout_s": 5}
+            )
+            self.assertEqual(
+                (code, body["ok"], body["reason"]), (409, False, "timeout")
+            )
+            for bad in (
+                {"action": "resize"},
+                {"action": "grow", "tail_tokens": "many"},
+                {"action": "status", "tail_tokens": 1},
+                {"action": "grow", "tail_tokens": -1},
+                {"action": "grow", "tail_tokens": True},
+                {"action": "shrink", "force": 1},
+                [1],
+            ):
+                code, body = self._http(tokenizer, body=bad)
+                self.assertEqual((code, body["ok"]), (400, False), bad)
+                self.assertEqual(body["reason"], "bad_request")
