+    def test_a_retry_after_an_unconfirmed_release_asks_the_device_again(self):
+        backend = ekt.FakeVmmBackend(granularity=GRAN)
+        backend.release_never_visible = True
+        rank = _Rank(self, backend=backend)
+        rank.grow()
+
+        def shrink_and_wait():
+            rank.outputs.clear()
+            out = rank.shrink(release_timeout_s=1)
+            if out is None:
+                rank.clock.now += 2
+                rank.tail.check_pending()
+                (out,) = rank.outputs
+            return out
+
+        first = shrink_and_wait()
+        self.assertEqual(first.info["reason"], "release_unconfirmed")
+        released = first.info["released_bytes"]
+        # Still not visible: the retry must not answer from memory.
+        again = shrink_and_wait()
+        self.assertFalse(again.ok)
+        self.assertEqual(again.info["reason"], "release_unconfirmed")
+        self.assertFalse(again.info["vram_confirmed"])
+        self.assertEqual(again.info["released_bytes"], released)
+        self.assertTrue(rank.tail.status()["release_unconfirmed"])
+        # The device catches up: now, and only now, the retry confirms.
+        backend.release_never_visible = False
+        final = shrink_and_wait()
+        self.assertTrue(final.ok, final.message)
+        self.assertTrue(final.info["vram_confirmed"])
+        self.assertTrue(final.info["rechecked"])
+        self.assertEqual(final.info["vram_freed_bytes_by_rank"], {"0": released})
+        self.assertFalse(rank.tail.status()["release_unconfirmed"])
+        # With nothing outstanding a further shrink is the plain no-op.
+        self.assertTrue(rank.shrink().ok)
