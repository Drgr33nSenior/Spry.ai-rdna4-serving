+    def _two_ranks(self, backends=(None, None)):
+        slots = [None, None]
+        barrier = threading.Barrier(2, timeout=30)
+
+        def gather_for(index):
+            def gather(report):
+                slots[index] = report
+                barrier.wait()
+                reports = list(slots)
+                barrier.wait()
+                return reports
+
+            return gather
+
+        return [
+            _Rank(self, rank=i, gather=gather_for(i), backend=backends[i])
+            for i in range(2)
+        ]
+
+    def _on_both(self, ranks, fn):
+        results, errors = [None, None], []
+
+        def run(i):
+            try:
+                results[i] = fn(ranks[i])
+            except BaseException as error:  # surfaced below
+                errors.append(error)
+
+        threads = [threading.Thread(target=run, args=(i,)) for i in range(2)]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join(60)
+        if errors:
+            raise errors[0]
+        return results
+
+    def _assert_identical(self, ranks):
+        a, b = ranks
+        self.assertEqual(a.tail.state, b.tail.state)
+        self.assertEqual(a.tail.tail_tokens, b.tail.tail_tokens)
+        self.assertEqual(a.limits[-1], b.limits[-1])
+        self.assertTrue(torch.equal(a.full.free_pages, b.full.free_pages))
+        self.assertTrue(torch.equal(a.full._tail_free, b.full._tail_free))
+        self.assertEqual(a.full.tail_outstanding, b.full.tail_outstanding)
+        self.assertEqual(a.full._tail_open, b.full._tail_open)
+        self.assertEqual(
+            sorted(a.tree_slots().tolist()), sorted(b.tree_slots().tolist())
+        )
+        self.assertEqual(
+            a.allocator.swa_available_size(), b.allocator.swa_available_size()
+        )
+        self.assertEqual(a.cache.evictable_size(), b.cache.evictable_size())
+
+    def test_two_ranks_end_identical(self):
+        ranks = self._two_ranks()
+        outs = self._on_both(ranks, lambda rank: rank.grow(250))
+        self.assertTrue(all(out.ok for out in outs))
+        self._assert_identical(ranks)
+        # The same requests on both ranks, as the broadcast delivers them.
+        filled = [self._fill(rank, random.Random(7), 40)[0] for rank in ranks]
+        held = [rank.allocator.alloc(20) for rank in ranks]
+        self._assert_identical(ranks)
+        self.assertGreater(int((ranks[0].tree_slots() > BASE).sum()), 0)
+        outs = self._on_both(ranks, lambda rank: rank.shrink())
+        self.assertEqual(outs, [None, None])
+        self._assert_identical(ranks)
+        for rank, index in zip(ranks, held):
+            rank.allocator.free(index)
+        self._on_both(ranks, lambda rank: rank.tail.check_pending())
+        for rank in ranks:
+            (out,) = rank.outputs
+            self.assertTrue(out.ok, out.message)
+            self.assertTrue(out.info["ranks_identical"])
+            self.assertEqual(sorted(out.info["vram_freed_bytes_by_rank"]), ["0", "1"])
+            self.assertEqual(int((rank.tree_slots() > BASE).sum()), 0)
+            rank.cache.sanity_check()
+        self.assertEqual(
+            ranks[0].outputs[0].info["evicted_tokens"],
+            ranks[1].outputs[0].info["evicted_tokens"],
+        )
+        self._assert_identical(ranks)
+        for seq, _ in filled[0]:
+            self.assertEqual(
+                match_prefix(ranks[0].cache, seq).device_prefix_len,
+                match_prefix(ranks[1].cache, seq).device_prefix_len,
+            )
+        outs = self._on_both(ranks, lambda rank: rank.grow())
+        self.assertTrue(all(out.ok for out in outs))
+        self._assert_identical(ranks)
