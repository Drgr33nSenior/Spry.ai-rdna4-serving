+class ElasticTailSuite(SWACheckpointWindowFixtures):
+    def _fill(self, rank, rng, count, next_token=1):
+        """Insert ``count`` prefixes; returns them with their slot ids."""
+        seqs = []
+        for _ in range(count):
+            base = rng.choice(seqs)[0] if seqs and rng.random() < 0.5 else []
+            keep = rng.randrange(len(base) + 1)
+            extra = rng.randint(4, 3 * self.window)
+            seq = base[:keep] + list(range(next_token, next_token + extra))
+            next_token += extra
+            if not self._make_room(rank.cache, rank.allocator, len(seq)):
+                continue
+            self._insert(rank.cache, rank.allocator, rank.pool, seq)
+            seqs.append((seq, None))
+        return seqs, next_token
+
+    def _path_slots(self, rank, seq):
+        match = match_prefix(rank.cache, seq)
+        if match.device_prefix_len == 0:
+            return match, torch.empty(0, dtype=torch.int64)
+        return match, rank.cache.path_device_indices(match.last_device_node)
+
+    def _assert_windows(self, rank, seqs):
+        for seq, _ in seqs:
+            match = match_prefix(rank.cache, seq)
+            node = match.last_device_node
+            if node == rank.cache.root_node_handle():
+                continue
+            spans = self._path(rank.cache, node, match.device_prefix_len)
+            for _, end, _, has_checkpoint in spans:
+                if not has_checkpoint:
+                    continue
+                window_start = max(0, end - self.window)
+                for start, stop, has_swa, _ in spans:
+                    if stop > window_start and start < end:
+                        self.assertTrue(has_swa)
+
