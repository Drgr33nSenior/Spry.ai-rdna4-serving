+class TestLimits(CustomTestCase):
+    def test_verify_kernel_takes_the_whole_reserved_pool(self):
+        # The gfx1201 target-verify kernel addresses the cache with int32
+        # offsets and needs contiguous, equally shaped K and V. At TP2 a rank
+        # holds 2 kv heads of dimension 256; the large arm's pool is the
+        # reserved size. Storage is not touched, only described.
+        from sglang.kernels.ops.attention import (
+            gfx1201_fp8_kv,
+            verify_attention_gfx1151 as verify,
+        )
+
+        rows = 645558 + 1
+        k = torch.empty((rows, 2, 256), dtype=torch.float8_e4m3fn)
+        v = torch.empty((rows, 2, 256), dtype=torch.float8_e4m3fn)
+        q = torch.empty((8, 12, 256), dtype=torch.bfloat16)
+        o = torch.empty((8, 12, 256), dtype=torch.bfloat16)
+        self.assertLess(k.numel(), 2**31)
+        self.assertLess((rows - 1) * 2 * 256 + 2 * 256, 2**31)
+        with (
+            mock.patch.object(verify, "enabled", lambda: True),
+            mock.patch.object(gfx1201_fp8_kv, "enabled", lambda: True),
+        ):
+            self.assertTrue(verify.covered(q, o, k, v, 8, 12, 2, 256))
+            too_big = torch.empty((2**31 // 512 + 1, 2, 256), dtype=k.dtype)
+            self.assertFalse(verify.covered(q, o, too_big, too_big, 8, 12, 2, 256))
