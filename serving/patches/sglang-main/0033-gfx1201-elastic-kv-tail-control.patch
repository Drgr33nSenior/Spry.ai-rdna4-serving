+    def test_waited_means_queued_behind_another_resize(self):
+        # 0.4 s between the call and the answer, 0.05 s of it in the scheduler.
+        tokenizer = self._tokenizer(
+            [KvTailReqOutput(ok=True, state="unbacked", info={"elapsed_s": 0.05})],
+            delay_s=0.4,
