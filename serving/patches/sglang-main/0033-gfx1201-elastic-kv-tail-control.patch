+        rank.allocator.free(filler)
+        self.assertLess(len(rank.full.free_pages), 60)
+        # Leave the idle tail prefix in place, so that making room in the
+        # base is what evicts it, after the slots to move were first counted.
+        with mock.patch.object(ekt, "evict_idle_tail_holders", lambda *args: 0):
+            out = rank.shrink()
