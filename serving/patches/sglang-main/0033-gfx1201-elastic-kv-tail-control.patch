+    def _tokenizer(self, replies, delay_s=0.0):
+        from sglang.srt.managers.tokenizer_control_mixin import TokenizerControlMixin
+
+        class Tokenizer(TokenizerControlMixin):
+            pass
+
+        tokenizer = Tokenizer()
+        tokenizer.context_len = 400
+        tokenizer.model_config = SimpleNamespace(context_len=400)
+        tokenizer.auto_create_handle_loop = lambda: None
+        tokenizer.seen = []
+
+        async def communicator(obj):
+            tokenizer.seen.append(obj.action)
+            await asyncio.sleep(delay_s)
+            return [replies.pop(0)]
+
+        tokenizer.kv_tail_communicator = communicator
+        tokenizer.kv_tail_status_communicator = communicator
+        return tokenizer
