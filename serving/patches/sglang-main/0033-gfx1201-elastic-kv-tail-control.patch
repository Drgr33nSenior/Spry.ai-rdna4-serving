+    def test_install_wires_a_scheduler(self):
+        env = {ekt.ENV_BASE_TOKENS: str(BASE), ekt.ENV_BASE_CONTEXT: "90"}
+        from sglang.srt.runtime_context import get_parallel
+
+        with mock.patch.dict(os.environ, env), get_parallel().override(tp_rank=0):
+            scheduler, allocator = self._scheduler()
