+        self.assertTrue(out.info["waited"])
+        self.assertGreater(out.info["queued_s"], 0.3)
+        # The same wall time spent in the scheduler (the device's release) is
+        # not a wait for anything else.
+        tokenizer = self._tokenizer(
+            [KvTailReqOutput(ok=True, state="unbacked", info={"elapsed_s": 0.4})],
+            delay_s=0.4,
+        )
+        out = asyncio.run(tokenizer.kv_tail(KvTailReqInput(action="shrink")))
+        self.assertFalse(out.info["waited"])
