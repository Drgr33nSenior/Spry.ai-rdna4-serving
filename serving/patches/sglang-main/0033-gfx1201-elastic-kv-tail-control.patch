+        self.assertEqual(out.info["evicted_tail_tokens"], len(unused))
+        self.assertEqual(out.info["evicted_base_tokens"], 0)
+        rank.assert_no_tail_refs()
+        # Request rows and the cache name the same new slots, which hold the
+        # same K and V; the idle prefix in the tail is gone, the base ones stay.
+        new_a, new_b = rank.row_slots(row_a), rank.row_slots(row_b)
