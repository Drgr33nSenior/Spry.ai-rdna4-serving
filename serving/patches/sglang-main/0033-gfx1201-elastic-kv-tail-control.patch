+
+        out = rank.shrink()
+
+        # It did not wait: one call, with both requests still running.
+        self.assertIsNotNone(out)
+        self.assertTrue(out.ok, out.message)
+        self.assertEqual(rank.events, ["close", "copy", "unmap"])
+        self.assertEqual(out.state, ekt.STATE_UNBACKED)
