+        self.assertIs(tail.allocator, allocator.full_attn_allocator)
+        self.assertIsNone(tail.owner.self_test_error)
+        # Two requests of at most 90 + 5 slots against a base of 192.
+        self.assertEqual(tail.base_margin, 2)
+        self.assertEqual(tail.status()["base_margin_tokens"], 2)
+        # The scheduler starts at the base although the pool is the large
+        # one, and requests are held to the base context.
+        self.assertEqual(scheduler.max_total_num_tokens, BASE)
+        self.assertEqual(scheduler.max_req_len, 89)
+        self.assertEqual(scheduler.max_req_input_len, 84)
+        self.assertEqual(allocator.full_available_size(), BASE)
+        self.assertEqual(self.backend.mapped_bytes(), tail.owner.base_bytes)
+        out = ekt.dispatch(tail, KvTailReqInput(action="grow"), KvTailReqOutput)
+        self.assertTrue(out.ok, out.message)
+        self.assertEqual(scheduler.max_total_num_tokens, self.cfg.kv_size)
+        self.assertEqual(scheduler.max_req_len, 89)
+        self.assertEqual(allocator.full_available_size(), self.cfg.kv_size)
+        # A running request whose KV sits in the tail of the real pool.
+        full = allocator.full_attn_allocator
+        table = scheduler.req_to_token_pool.req_to_token
+        k_buffer = allocator.get_kvcache().full_kv_pool.k_buffer[0]
+        filler = full.alloc(BASE)
+        own = allocator.alloc(20)
+        full.free(filler)
+        self.assertGreater(int(own.min()), BASE)
+        values = torch.arange(1, 21, dtype=k_buffer.dtype)
+        k_buffer[own] = values[:, None, None]
+        table[590, :20] = own.to(table.dtype)
+        self.running.append(self._live_req(590, 20))
+        # A finished request left its slot ids in its row; a response held on
+        # the output rank is not a running request.
+        table[3, :4] = torch.tensor([5, BASE, BASE + 90, BASE + 60], dtype=table.dtype)
