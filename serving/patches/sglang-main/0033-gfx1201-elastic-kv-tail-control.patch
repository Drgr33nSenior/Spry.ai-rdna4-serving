+                self._run_random_cycles(seed)
+
+    def _run_random_cycles(self, seed):
+        rank = _Rank(self)
+        rng = random.Random(seed)
+        seqs, locks, next_token, shrinks = [], [], 1, 0
+        for step in range(400):
+            op = rng.random()
+            state = rank.tail.state
+            if op < 0.04 and state == ekt.STATE_UNBACKED:
+                tokens = rng.randint(1, self.cfg.kv_size - BASE)
+                self.assertTrue(rank.grow(tokens).ok)
+            elif op < 0.10 and state == ekt.STATE_BACKED:
+                rank.outputs.clear()
+                out = rank.shrink(timeout_s=1e9)
+                if out is None:
+                    # Requests finish; the shrink completes on a later step.
+                    for lock in locks:
+                        rank.cache.unlock(lock)
+                    locks.clear()
+                    rank.tail.check_pending()
+                    (out,) = rank.outputs
+                self.assertTrue(out.ok, out.message)
+                shrinks += 1
+                self.assertEqual(rank.tail.state, ekt.STATE_UNBACKED)
+                self.assertEqual(int((rank.tree_slots() > BASE).sum()), 0)
+                self.assertEqual(rank.full.tail_outstanding, 0)
+                self.assertEqual(rank.backend.mapped_bytes(), rank.owner.base_bytes)
+            elif op < 0.55 or not seqs:
+                grown, next_token = self._fill(rank, rng, 1, next_token)
+                seqs.extend(grown)
+            elif op < 0.75:
+                match = match_prefix(rank.cache, rng.choice(seqs)[0])
+                if match.last_device_node != rank.cache.root_node_handle():
+                    locks.append(rank.cache.lock(match.last_device_node))
+            elif locks:
+                rank.cache.unlock(locks.pop(rng.randrange(len(locks))))
+            rank.cache.sanity_check()
+            self._assert_windows(rank, seqs)
+            slots = rank.tree_slots()
+            backed = rank.tail.state != ekt.STATE_UNBACKED
+            limit = BASE + (rank.tail.tail_tokens if backed else 0)
+            if slots.numel():
+                self.assertLessEqual(int(slots.max()), limit)
+            # The leak check's identity: free + cached + unavailable = pool.
+            self.assertEqual(
+                rank.full.available_size()
+                + rank.cache.full_evictable_size()
+                + rank.cache.full_protected_size()
+                + rank.full.unavailable_size(),
+                self.cfg.kv_size,
+            )
+            (full_capacity, full_available), _ = (
+                rank.allocator.swa_capacity_and_available(
+                    full_capacity=self.cfg.kv_size, swa_capacity=0
+                )
+            )
+            self.assertEqual(
+                full_capacity,
+                full_available
+                + rank.cache.full_evictable_size()
+                + rank.cache.full_protected_size(),
+            )
+        self.assertGreater(shrinks, 2)
+
