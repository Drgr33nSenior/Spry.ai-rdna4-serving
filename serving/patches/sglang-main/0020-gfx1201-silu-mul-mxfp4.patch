+        quark_w4a4_mxfp4._use_gfx1201_mxfp4
+        and type(getattr(mlp.down_proj, "scheme", None)) is quark_w4a4_mxfp4.QuarkW4A4MXFP4
+        and not getattr(mlp.down_proj, "dequantized_bf16", False)
+    )
+
