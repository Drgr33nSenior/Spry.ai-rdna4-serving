+class QwenBF16FixedPoolConfigurator(MemoryPoolConfigurator):
+    """Fixed physical-slot plan after stock GDN reservation; not capacity sizing."""
+
+    def __init__(self, kvc):
+        from sglang.srt.layers.attention.ultraquant_contract import bf16_pool_policy
