  "conclusions": [
    {
      "confidence": "high",
      "finding": "Latest long requests spend most server elapsed time after decode is already underway; repeated generation is the dominant service phase."
    },
    {
      "confidence": "high within older short-C1 timing only",
      "finding": "About95% of measured target-graph interval is outside output-head and output-gather subintervals; no model-body kernel attribution exists."
    },
    {
      "confidence": "high",
      "finding": "Latest client-minus-server difference is2.3\u20135.7ms; API/transport difference is small, but internal CPU scheduling remains included in server time."
    },
    {
      "confidence": "candidate only",
      "finding": "Native DFlash2 selector uses a large-vocabulary torch.topk fallback in the draft graph. Its cost is not timed; it cannot be called dominant or a demonstrated2x opportunity."
    },
    {
      "confidence": "not established",
      "finding": "Latest draft versus target versus acceptance/commit GPU shares, and GEMM versus GDN versus attention versus layer-collective shares, are not measured."
    },
    {
      "confidence": "scope limitation",
      "finding": "The latest SamplingRoute witness validates and hashes input IDs on every sampled acceptance call. Its CPU cost is included in server time and has not been isolated."
    }
