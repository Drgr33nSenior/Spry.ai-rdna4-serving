    "findings": [
      {
        "id": "draft_topk",
        "observation": "Draft selector uses local topk16 over expected C1 shape7x124160, then topk16 over7x32 merged candidates. Source and latest fallback warnings support active-path attribution; latency unmeasured."
      },
      {
        "id": "sampled_target_topk",
        "observation": "Publisher topk20/top_p.95 target verification uses top-k-first probability builder over expected8x248320 logits on each rank, then small top-p and dense zero/scatter output. Different from draft topk16."
      },
      {
        "id": "existing_hip_dsa",
        "observation": "HIP DSA implementation is compiled for k2048 and returns int32 indices. It is not a k16/k20 values-plus-indices replacement."
      },
      {
        "id": "existing_jit",
        "observation": "JIT fast_topk accepts512/2048 and unspecified output order; not the selector contract."
      },
      {
        "id": "existing_lilicorr",
        "observation": "Tiled Triton topk/LSE accepts draft k16 but target k20 triggers the non-power-of-two guard and full torch.topk plus LSE. Tiled route computes unused LSE, creates scratch and calls smaller torch.topk. H100 geometry, ties, finite sentinel and padded tails need review; not qualified on gfx1201."
      },
      {
        "id": "sparse_target_existing",
        "observation": "Target probability builder already applies topk before top_p; do not claim eliminating a nonexistent full-vocabulary top-p sort."
      },
      {
        "id": "observer",
        "observation": "SamplingRoute validates and hashes complete origin IDs on each successful/attempted selector acceptance. CPU overhead is part of diagnostic time, not an established production bottleneck."
      }
    ],
